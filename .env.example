# Copie para ".env" e ajuste. NÃO versione o .env.

# --- Greenbone / GMP ---
GMP_USERNAME=admin
GMP_PASSWORD=troque-esta-senha
# Volume Docker com o socket do gvmd (docker volume ls | grep gvmd)
GVMD_SOCKET_VOLUME=greenbone-community-edition_gvmd_socket_vol

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=vuln
POSTGRES_PASSWORD=troque-esta-senha-do-banco
POSTGRES_DB=vuln

# --- Portal / API ---
# Segredo para assinar os tokens de sessão (gere um valor longo e aleatório).
APP_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Senha inicial de TODAS as equipes no primeiro boot (troque depois).
DEFAULT_TEAM_PASSWORD=mudar@123
# Interface onde o portal (HTTPS, porta 8443) fica disponível.
# 127.0.0.1 = só localhost; use o IP de gerência do servidor (ex.: 10.20.0.10)
# para as equipes acessarem em https://vuln.example.local:8443
WEB_BIND=127.0.0.1

# --- Fase 4: Login via Active Directory / LDAP ---
# Ligue (1) para autenticar pelo AD; desligado (0) usa só as contas locais.
LDAP_ENABLED=0
LDAP_SERVER=ldaps://dc01.example.local:636
LDAP_DOMAIN=example.local
LDAP_BASE_DN=DC=example,DC=local
# STARTTLS em ldap:// (389); com ldaps:// deixe 0.
LDAP_START_TLS=0
# (Opcional) conta de serviço só-leitura p/ resolver grupos. Sem ela, a própria
# credencial da pessoa é usada na busca.
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
# O mapeamento grupo→equipe fica em config/config.yaml (ldap.group_map).

# --- Fase 4: Notificações no Microsoft Teams ---
# Ligado por padrão quando notifications.enabled=true no config.yaml. 0 desliga.
NOTIFY_ENABLED=1
# Webhooks dos canais (Incoming Webhook do Teams). Podem ficar aqui ou no
# config.yaml (notifications.webhooks). O valor do .env tem prioridade.
TEAMS_WEBHOOK_DEFAULT=
TEAMS_WEBHOOK_INFRA=
TEAMS_WEBHOOK_REDES=
TEAMS_WEBHOOK_DEV=
TEAMS_WEBHOOK_SEG=
# Link do portal usado nos botões dos cards.
PORTAL_URL=https://vuln.example.local:8443
